---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('bookshelf');
const reading = all.filter((b) => b.data.status === 'reading');
const finished = all.filter((b) => b.data.status === 'finished');
const abandoned = all.filter((b) => b.data.status === 'abandoned');
---
<Base title="Bookshelf" description="What I'm reading and what I've finished.">
  <header class="head">
    <h1>Mostly novels, sometimes manuals.</h1>
  </header>

  {reading.length > 0 && (
    <section>
      <h2 class="section-h">Currently</h2>
      <ul class="list">
        {reading.map((b) => (
          <li>
            <span class="title">{b.data.title}</span>
            <span class="muted"><span aria-hidden="true">— </span>{b.data.author}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {finished.length > 0 && (
    <section>
      <h2 class="section-h">Finished</h2>
      <ul class="list">
        {finished.map((b) => (
          <li>
            <span class="title">{b.data.title}</span>
            <span class="muted"><span aria-hidden="true">— </span>{b.data.author}</span>
            {b.data.rating && <span class="rating mono faint" role="img" aria-label={`Rated ${b.data.rating} out of 5`}>{'★'.repeat(b.data.rating)}</span>}
          </li>
        ))}
      </ul>
    </section>
  )}

  {abandoned.length > 0 && (
    <section>
      <h2 class="section-h">Abandoned</h2>
      <ul class="list">
        {abandoned.map((b) => (
          <li>
            <span class="title">{b.data.title}</span>
            <span class="muted"><span aria-hidden="true">— </span>{b.data.author}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {all.length === 0 && <p class="muted">Nothing on the shelf right now.</p>}
</Base>

<style>
  .head { margin-block: 1rem 2rem; }
  .head h1 { margin-block: 0 0.4rem; }
  .section-h {
    font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--fg-faint); margin-block: 2rem 0.8rem;
    font-family: var(--font-mono); font-weight: 400;
  }
  .list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .list li { display: flex; gap: 0.5rem; align-items: baseline; padding-block: 0.4rem; border-bottom: 1px solid var(--line); }
  .title { font-size: 1.02rem; }
  .rating { font-size: 0.8rem; margin-left: auto; }
</style>
