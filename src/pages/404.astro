---
import Base from '../layouts/Base.astro';
---
<Base title="404" description="Lost.">
  <section class="lost">
    <p class="kicker mono">HTTP/1.1 404</p>
    <h1>This page is on a sabbatical.</h1>
    <p class="muted">
      It might come back. It might not. Either way, here are some pages that definitely exist:
    </p>
    <ul class="list">
      <li><a class="link" href="/">Home</a></li>
      <li><a class="link" href="/work">Work</a></li>
      <li><a class="link" href="/writing">Writing</a></li>
      <li><a class="link" href="/about">About</a></li>
    </ul>
    <pre class="ascii mono" aria-hidden="true">{`
       .---.
      / 4 0 \\     ¯\\_(ツ)_/¯
      \\  4  /
       '---'
    `}</pre>
  </section>
</Base>

<style>
  .lost { display: flex; flex-direction: column; gap: 1rem; max-width: 50ch; padding-block: 2rem; }
  .kicker { font-size: 0.78rem; letter-spacing: 0.1em; color: var(--accent); }
  h1 { margin-block: 0.4rem 0.6rem; }
  .list { list-style: none; padding: 0; margin: 0.5rem 0; display: flex; flex-wrap: wrap; gap: 1rem; }
  .ascii {
    color: var(--fg-faint);
    font-size: 0.82rem;
    margin-top: 1rem;
    white-space: pre;
  }
</style>
