---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description ?? post.data.title}>
  <article class="post">
    <p class="kicker mono">
      {post.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' })}
    </p>
    <h1>{post.data.title}</h1>
    {post.data.description && <p class="lede muted">{post.data.description}</p>}
    <hr class="hairline" />
    <div class="prose">
      <Content />
    </div>
    <hr class="hairline" />
    <p class="muted small">
      <a class="link" href="/writing">← All writing</a>
    </p>
  </article>
</Base>

<style>
  .kicker { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--fg-faint); }
  .post h1 { margin-block: 0.5rem 0.6rem; max-width: 22ch; }
  .lede { font-size: 1.1rem; line-height: 1.55; max-width: 50ch; }
  .prose :global(p) { font-size: 1.03rem; line-height: 1.7; margin-block: 1rem; }
  .prose :global(h2) { margin-block: 2rem 0.6rem; }
  .prose :global(h3) { margin-block: 1.6rem 0.4rem; }
  .prose :global(a) { color: var(--accent); border-bottom: 1px solid var(--accent-soft); }
  .prose :global(a:hover) { border-bottom-color: var(--accent); }
  .prose :global(code) {
    background: var(--bg-sunken);
    padding: 0.1em 0.4em;
    border-radius: 4px;
    border: 1px solid var(--line);
  }
  .prose :global(pre) {
    background: var(--bg-sunken);
    padding: 1rem;
    border-radius: var(--radius);
    overflow-x: auto;
    border: 1px solid var(--line);
  }
  .prose :global(pre code) { background: none; border: 0; padding: 0; }
  .prose :global(blockquote) {
    border-left: 2px solid var(--accent);
    padding-left: 1rem;
    color: var(--fg-muted);
    font-style: italic;
    margin: 1.4rem 0;
  }
  .small { font-size: 0.88rem; }
</style>
