---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Writing" description="Notes, essays, and longer thoughts.">
  <header class="head">
    <h1>Notes & essays.</h1>
    <p class="muted">Infrequent. On purpose.</p>
  </header>

  <ul class="list">
    {posts.length === 0 && (
      <li class="muted">Nothing yet — but soon.</li>
    )}
    {posts.map((p) => (
      <li>
        <a href={`/writing/${p.id}`}>
          <span class="title">{p.data.title}</span>
          <span class="date mono faint">
            {p.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' })}
          </span>
        </a>
        {p.data.description && <p class="muted small">{p.data.description}</p>}
      </li>
    ))}
  </ul>
</Base>

<style>
  .head { margin-block: 1rem 2.5rem; }
  .head h1 { margin-block: 0 0.4rem; }
  .list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1.4rem; }
  .list a {
    display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--line);
    transition: border-color .2s ease, color .2s ease;
  }
  .list a:hover { border-bottom-color: var(--accent); color: var(--accent); }
  .title { font-size: 1.08rem; }
  .date { font-size: 0.78rem; flex-shrink: 0; }
  .small { font-size: 0.88rem; margin-top: 0.4rem; }
</style>
