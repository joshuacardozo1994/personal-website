---
import Base from '../layouts/Base.astro';
const experiments: Array<{ title: string; status: string; href?: string; note: string }> = [
  { title: 'My own little NAS', status: 'wip', note: 'A Pi and a spare SSD, so my devices stop routing everything through someone else\'s cloud.' },
  { title: 'XO that won\'t end', status: 'wip', note: 'Tic-tac-toe, but your oldest move disappears. So it never settles into a draw.' },
];
---
<Base title="Lab" description="Things I'm tinkering with.">
  <header class="head">
    <h1>Things I'm tinkering with.</h1>
    <p class="muted">Most of these won't become products, and that was never the plan, I build them to find out if the idea holds up.</p>
  </header>

  <ul class="list">
    {experiments.map((e) => (
      <li>
        <span class={`status mono status-${e.status}`}>{e.status}</span>
        <div class="copy">
          <h3>{e.href ? <a class="link" href={e.href}>{e.title}</a> : e.title}</h3>
          <p class="muted small">{e.note}</p>
        </div>
      </li>
    ))}
  </ul>
</Base>

<style>
  .head { margin-block: 1rem 2rem; max-width: 50ch; }
  .head h1 { margin-block: 0 0.4rem; }
  .list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1.2rem; }
  .list li { display: flex; gap: 1rem; padding-block: 0.4rem; }
  .status {
    flex-shrink: 0;
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--fg-muted);
    height: fit-content;
    margin-top: 0.2rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .status-wip { color: var(--accent); border-color: var(--accent-soft); }
  .copy { display: flex; flex-direction: column; gap: 0.25rem; }
  h3 { font-size: 1.05rem; }
  .small { font-size: 0.92rem; }
</style>
